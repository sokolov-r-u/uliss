# TLS variant for full docker-compose, selected there by NGINX_ENVSUBST_TEMPLATE_DIR; the image default is ../http.
# The nginx image renders this template with envsubst (only WEB_* variables, see the Dockerfile).
# Login cookies belong to one host and the OAuth callback always returns to the canonical one,
# so any other Host (an IP, localhost) is sent there before a login can start.

# certificate from infra/tls/generate-certs.sh, mounted by infra/docker-compose.yml
ssl_certificate /etc/nginx/tls/uliss.home.pem;
ssl_certificate_key /etc/nginx/tls/uliss.home-key.pem;

# Shared by both variants (http context): no version in error pages and headers; text assets compressed.
server_tokens off;
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;

server {
    listen 80 default_server;
    server_name _;

    # compose healthcheck; plain HTTP so it needs neither TLS nor the canonical Host
    location = /healthz {
        access_log off;
        return 200;
    }

    # 302: a cached 301 would keep sending localhost:80 here after another app takes the port
    location / {
        return 302 https://${WEB_CANONICAL_HOST}$request_uri;
    }
}

server {
    listen 80;
    server_name ${WEB_AUTH_HOST};
    return 302 https://${WEB_AUTH_HOST}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;
    return 302 https://${WEB_CANONICAL_HOST}$request_uri;
}

# auth (login pages, OAuth endpoints) over TLS for full docker-compose; under k8s Ingress routes this host itself
server {
    listen 443 ssl;
    http2 on;
    server_name ${WEB_AUTH_HOST};

    location / {
        proxy_pass http://auth:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # auth trusts these (forward-headers-strategy: framework), so overwrite client values
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
        # Spring Security adds HSTS on https; it would pin auth.uliss.home (any port, so bootRun :9000 too) to TLS
        proxy_hide_header Strict-Transport-Security;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${WEB_CANONICAL_HOST};
    include /etc/nginx/snippets/uliss-app.conf;
}
