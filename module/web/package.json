{
  "name": "@uliss/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "visual:build": "vite build --config visual/vite.config.ts",
    "visual:serve": "vite --config visual/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "visual:test": "../../scripts/playwright-docker.sh test",
    "visual:test:container": "playwright test",
    "visual:update": "../../scripts/playwright-docker.sh update",
    "visual:update:container": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@uliss/design-system": "*",
    "d3-force": "3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "3.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
