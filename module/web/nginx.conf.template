# The nginx image renders this template with envsubst (only WEB_* variables, see the Dockerfile).
# Login cookies belong to one host and the OAuth callback always returns to the canonical one,
# so any other Host (an IP, localhost) is sent there before a login can start.

# certificate from infra/tls/generate-certs.sh, mounted by infra/docker-compose.yml
ssl_certificate /etc/nginx/tls/uliss.home.pem;
ssl_certificate_key /etc/nginx/tls/uliss.home-key.pem;

server {
    listen 80 default_server;
    server_name _;

    # compose healthcheck; plain HTTP so it needs neither TLS nor the canonical Host
    location = /healthz {
        access_log off;
        return 200;
    }

    # 302: a cached 301 would keep sending localhost:80 here after another app takes the port
    location / {
        return 302 https://${WEB_CANONICAL_HOST}$request_uri;
    }
}

server {
    listen 80;
    server_name ${WEB_AUTH_HOST};
    return 302 https://${WEB_AUTH_HOST}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;
    return 302 https://${WEB_CANONICAL_HOST}$request_uri;
}

# auth (login pages, OAuth endpoints) over TLS for full docker-compose; under k8s Ingress routes this host itself
server {
    listen 443 ssl;
    http2 on;
    server_name ${WEB_AUTH_HOST};

    location / {
        proxy_pass http://auth:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # auth builds redirects from these (forward-headers-strategy: framework), so overwrite client values
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Forwarded "";
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${WEB_CANONICAL_HOST};
    root /usr/share/nginx/html;
    index index.html;

    # hashed assets are immutable
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA entry document must never be cached
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # same-origin routing for full docker-compose (no ingress there); inert under k8s, where
    # Ingress routes /user and /note straight to those services before traffic reaches this pod
    location /user/ {
        proxy_pass http://user:8080/user/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /note/ {
        proxy_pass http://note:8081/note/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # dictation uploads; note-service refuses recordings over 10 MB itself
        client_max_body_size 12m;

        # Chat message POST responses are SSE (text/event-stream); nginx's default response
        # buffering would hold tokens back until the buffer fills or the stream ends
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # client-side routing: unknown paths fall back to the SPA
    location / {
        try_files $uri /index.html;
    }
}
