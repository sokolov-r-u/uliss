# The nginx image renders this template with envsubst (only WEB_* variables, see the Dockerfile).
# Login cookies belong to one host and the OAuth callback always returns to the canonical one,
# so any other Host (an IP, localhost) is sent there before a login can start.
server {
    listen 80 default_server;
    server_name _;
    # 302: a cached 301 would keep sending localhost:80 here after another app takes the port
    return 302 $scheme://${WEB_CANONICAL_HOST}$request_uri;
}

server {
    listen 80;
    server_name ${WEB_CANONICAL_HOST};
    root /usr/share/nginx/html;
    index index.html;

    # hashed assets are immutable
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA entry document must never be cached
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # same-origin routing for full docker-compose (no ingress there); inert under k8s, where
    # Ingress routes /user and /note straight to those services before traffic reaches this pod
    location /user/ {
        proxy_pass http://user:8080/user/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /note/ {
        proxy_pass http://note:8081/note/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # dictation uploads; note-service refuses recordings over 10 MB itself
        client_max_body_size 12m;

        # Chat message POST responses are SSE (text/event-stream); nginx's default response
        # buffering would hold tokens back until the buffer fills or the stream ends
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # client-side routing: unknown paths fall back to the SPA
    location / {
        try_files $uri /index.html;
    }
}
