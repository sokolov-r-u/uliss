{
  "name": "@uliss/design-system",
  "version": "0.0.1",
  "type": "module",
  "description": "Uliss design system — CSS tokens, fonts and React components shared by the auth server (Thymeleaf) and the web SPA (React).",
  "exports": {
    ".": "./src/react/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens/*": "./src/tokens/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "postcss \"src/**/*.css\" --base src --dir dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.30",
    "postcss-cli": "^11.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "sideEffects": [
    "**/*.css"
  ]
}
