{
  "name": "@uliss/design-system",
  "version": "0.0.1",
  "type": "module",
  "description": "Uliss design system — CSS tokens, fonts and React components shared by the auth server (Thymeleaf) and the web SPA (React).",
  "exports": {
    ".": "./src/react/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens/*": "./src/tokens/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "postcss \"src/**/*.css\" --base src --dir dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "emoji-picker-element": "1.29.1"
  }
}
