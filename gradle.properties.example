# Copy this file to gradle.properties and adjust values for your environment.

# Base image used by Jib (io.uliss.docker-conventions) — our own image, built from
# infra/docker/base-jre/Dockerfile by .github/workflows/docker-publish.yml's base-jre job.
docker.jre.version=ghcr.io/sokolov-r-u/base-jre:25.0.3_9

# Path to the docker executable used by Jib
docker.executable=/usr/local/bin/docker

# Gradle build performance: reuse task outputs between builds and run independent modules in parallel
org.gradle.caching=true
org.gradle.parallel=true
