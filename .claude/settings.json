{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git revert:*)",
      "Bash(git commit --amend:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(psql:*)",
      "EnterWorktree"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash-guard.sh"
          }
        ]
      }
    ]
  }
}
