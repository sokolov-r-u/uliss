{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git revert:*)",
      "Bash(git commit --amend:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(psql:*)",
      "EnterWorktree",
      "Read(**/.env)"
    ],
    "ask": [
      "DesignSync"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/file-guard.sh"
          }
        ]
      }
    ]
  }
}
